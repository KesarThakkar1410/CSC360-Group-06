<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.app.SplashController"
           prefWidth="400" prefHeight="300"
           style="-fx-background-color: #FFC0CB;">

    <VBox alignment="CENTER" spacing="15">
        <ImageView fitWidth="100" fitHeight="100" preserveRatio="true">
            <image>
                <Image url="@logo.jpg"/>
            </image>
        </ImageView>
        <Label text="My Application" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
        <ProgressBar fx:id="progressBar" prefWidth="200"/>
    </VBox>

</StackPane>